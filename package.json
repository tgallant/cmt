{
  "name": "cmt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Close My Tabs: a keyboard-first Firefox tab manager",
  "homepage": "https://github.com/tgallant/cmt#readme",
  "repository": { "type": "git", "url": "https://github.com/tgallant/cmt.git" },
  "bugs": { "url": "https://github.com/tgallant/cmt/issues" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "lint": "addons-linter dist --warnings-as-errors",
    "verify": "npm test && npm run build && npm run lint",
    "test:firefox": "npm run package && node --test --test-concurrency=1 tests/browser/firefox.test.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "selenium-webdriver": "^4.35.0",
    "geckodriver": "^6.0.0",
    "addons-linter": "^10.14.0",
    "@zip.js/zip.js": "^2.23.0"
  }
}
